# =============================================================================
#  号機(Pi)側: マイク音声を集約ハブへ push する常駐サービス
# -----------------------------------------------------------------------------
#  設置は deploy/robot/app_setup.sh に MIC_SERVICE=1 を付けたときだけ行われる。
#  既定では master_control の Web UI から起動する運用 (programs.json の "mic")。
#  **両方を同時に動かさないこと** — ハブは 1 号機に 1 publisher しか受け付けず、
#  二重起動は 409 で弾かれる (docs/protocols/mic.md)。
#
#  設定を /etc/default に置くのは意図的。リポジトリ内の設定ファイルに書くと
#  git pull で号機ごとの差分が巻き戻る（programs.json で実際に起きている）。
# =============================================================================
[Unit]
Description=RescuePiSystem mic publisher (push mic audio to the hub)
Documentation=https://github.com/KinkiKnights/RescuePiSystem
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
# ALSA デバイスを開くには audio グループが要る（未所属だと arecord から
# 録音デバイスが見えない）。
SupplementaryGroups=audio

EnvironmentFile=/etc/default/mic-publisher
# 録音デバイスと取り込みレートは指定しない。master_control の「デバイス設定」
# (~/.config/rescue-pi/devices.json) を publisher 自身が読む。/etc/default で
# MIC_DEVICE / MIC_CAPTURE_RATE を設定した場合はそちらが優先される。
Environment=HOME=@HOME@
Environment=RESCUE_DEVICES_CONFIG=@HOME@/.config/rescue-pi/devices.json
ExecStart=/usr/bin/python3 @REPO_DIR@/robot/mic_publisher/mic_publisher.py \
    --hub ${MIC_HUB} \
    --unit ${MIC_UNIT}

# publisher 自身もハブ断で再接続し続けるが、arecord ごと作り直したい種類の
# 異常（デバイスの抜き差しなど）に備えて systemd 側でも必ず起こし直す。
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

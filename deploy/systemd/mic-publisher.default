# /etc/default/mic-publisher — 号機ごとの設定
#   雛形は deploy/systemd/mic-publisher.default。/etc/default/mic-publisher は
#   初回だけ設置され、以後 git pull で上書きされない。
# 集約ハブの URL（kkrtx の固定アドレス）
MIC_HUB=http://192.168.10.3:8770
# 号機 ID。ハブ側のパスになる（5 なら http://kkrtx:8770/5 で聴ける）
MIC_UNIT=5
# 録音デバイスと取り込みレートは通常ここでは設定しない。
# master_control の「デバイス設定」(~/.config/rescue-pi/devices.json) を
# publisher 自身が読み、カード名 (hw:CARD=<名前>,DEV=0) で安定して開く。
# ここで設定するとそちらが優先される（意図的に固定したいときだけ使う）。
#MIC_DEVICE=hw:CARD=Device,DEV=0
#MIC_CAPTURE_RATE=48000
